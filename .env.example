# Copy this file to .env for local development (.env is gitignored, never committed).
# For production, set these same values in Netlify's dashboard instead:
# Site configuration → Environment variables. Vite reads VITE_-prefixed vars at
# BUILD time and inlines them into the shipped JS — same as if they were
# hardcoded, just configurable per-environment without touching code.
#
# All three are OPTIONAL. If left unset, the app falls back to the current
# live project's values, so this is safe to leave alone if you're not
# switching to a different Supabase project.

# Your Supabase project URL (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://bymmifuxvrhomqiisntv.supabase.co

# Your Supabase publishable/anon key (Project Settings → API → anon public key).
# This is a PUBLIC key by design — safe to commit to a public repo, safe to
# ship in the built JS. It is not a secret. Your actual security comes from
# the Row Level Security policies in SETUP-ACCOUNTS.md, not from hiding this key.
VITE_SUPABASE_ANON_KEY=sb_publishable_qmC0F04efpUP-FuEJ60Qcw_zgf7ITtN

# The one email allowed to see the Analytics dashboard. Must also match the
# email hardcoded into the SQL policy for nol_pageviews/nol_events/nol_veto_stats
# in SETUP-ACCOUNTS.md — both have to agree, or Analytics stays hidden.
VITE_ADMIN_EMAIL=cyber1patriot@gmail.com

# --- These are NOT set here on purpose ---
# TMDB_KEY and OMDB_KEY are genuine secrets and must stay server-side only,
# set directly in Netlify's environment variables (no VITE_ prefix — that
# prefix is what tells Vite "bake this into the public bundle", which is
# exactly what you don't want for these two). They're read by the Netlify
# Functions in netlify/functions/, never by the browser-side app code.
